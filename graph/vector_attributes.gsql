// FraudGraph Investigator -- vector attributes v1
//
// TigerGraph 4.2 does not allow a vector attribute inside CREATE VERTEX. It is
// always added to an existing vertex type with ALTER VERTEX ... ADD VECTOR
// ATTRIBUTE inside a SCHEMA_CHANGE JOB, so this is a separate file run after
// graph/schema.gsql.
//
// Verified against the workspace: server version 4.2.5.
//
// The job is global because CREATE VERTEX always creates a global type, so the
// vertices it alters are global too.
//
// DIMENSION 1536 matches OpenAI text-embedding-3-small, so the embedding model
// can be swapped without a schema migration. Vectors are produced locally for
// now; what the challenge requires is that TigerGraph is the vector store and
// the retrieval path, which it is either way.
//
// METRIC COSINE because these are text-similarity embeddings, where direction
// carries the meaning and magnitude does not.
//
// INDEXTYPE HNSW and DATATYPE FLOAT are the documented defaults, stated
// explicitly so the index cannot change under us on an upgrade.

CREATE GLOBAL SCHEMA_CHANGE JOB add_case_memory_vectors {
  // Closed-case narratives: the contrastive prior-case memory.
  ALTER VERTEX ClosedCase ADD VECTOR ATTRIBUTE memory_embedding(
    DIMENSION=1536, METRIC="COSINE", INDEXTYPE="HNSW", DATATYPE="FLOAT"
  );

  // Policy, typology and regulatory chunks: the policy context for GraphRAG.
  ALTER VERTEX PolicyChunk ADD VECTOR ATTRIBUTE policy_embedding(
    DIMENSION=1536, METRIC="COSINE", INDEXTYPE="HNSW", DATATYPE="FLOAT"
  );

  // This agent's own closed investigations, so later cases retrieve them as
  // memory too. Benchmark cases stay excluded by memory_epoch, not by absence
  // from the index.
  ALTER VERTEX InvestigationCase ADD VECTOR ATTRIBUTE memory_embedding(
    DIMENSION=1536, METRIC="COSINE", INDEXTYPE="HNSW", DATATYPE="FLOAT"
  );
}

RUN GLOBAL SCHEMA_CHANGE JOB add_case_memory_vectors
