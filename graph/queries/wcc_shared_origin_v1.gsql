// wcc_shared_origin_v1
//
// Weakly connected component over the time-local shared-origin subgraph.
//
// The question it answers: which other cards are reachable from this one by a
// chain of shared devices, using only activity that existed at the case anchor?
// That is the structural evidence policy R6 needs before a case may claim
// several cards show fraud from one origin.
//
// ---------------------------------------------------------------------------
// WHAT THIS IS
// ---------------------------------------------------------------------------
// A weakly connected component search in GSQL, run as breadth-first expansion
// from the seed card so it yields that card's component rather than labelling
// the whole graph -- the only component an investigation is asking about.
//
// Written here rather than called from the TigerGraph Graph Data Science
// library because that library is not installed in this workspace, and because
// tg_wcc labels whole vertex sets with no way to restrict edges to a time
// window. A component over all six months would answer a question the
// investigator never asked.
//
// ---------------------------------------------------------------------------
// ELIGIBILITY IS COUNTED IN DISTINCT CARDS
// ---------------------------------------------------------------------------
// A device joins cards only when it touches at least 2 and at most
// max_device_cards DISTINCT CARDS in-window.
//
// An earlier version counted transactions instead. One card making fifty
// purchases on its own laptop then looked like fifty cards and was excluded as
// a supernode, while the genuinely shared devices this query exists to find
// were judged on a number that had nothing to do with sharing. A threshold only
// means something when the thing counted is the thing it is named after.
//
// ---------------------------------------------------------------------------
// ELIGIBILITY IS COMPUTED ONLY WHERE THE SEARCH GOES
// ---------------------------------------------------------------------------
// Eligibility is evaluated per hop, for the devices the current frontier
// actually reaches in-window, and cached on the vertex so a device is costed
// once per run. An earlier version scanned every DeviceProfile in the graph on
// every call -- 9,706 devices and their whole transaction history -- to answer
// a question about one card's neighbourhood.
//
// d.n_transactions gates that work as an O(1) RESOURCE precheck. It is a
// lifetime aggregate, it decides only affordability, it is never evidence, and
// the devices it excludes are counted and reported.
//
// ---------------------------------------------------------------------------
// PROVENANCE
// ---------------------------------------------------------------------------
// A component alone is not evidence anyone can check. Every joined card comes
// back with the devices that joined it, the hop it was reached at, and the
// PREDECESSOR CARDS it was reached from.
//
// Those two sets are not enough on their own. When several paths reach one
// member, separate via_from_cards and via_devices sets lose which predecessor
// used which device: {A, B} and {d1, d2} cannot say whether A shared d1 or d2.
// So the query also returns PATH SEGMENTS, each an exact
// (from_card, device_id, to_card, hop) edge of the search: from_card sits at
// hop - 1, and both cards transacted on device_id inside the window and at or
// before the effective cutoff. Following segments back from any member to the
// seed reconstructs a complete path, one hop per segment.
//
// Segments are recorded only from the same temporally bounded expansion that
// admits members, so they obey the same cutoff and window. They are
// deduplicated, then capped at max_path_segments in (hop, to_card, from_card,
// device_id) order. Because hop sorts first, a returned segment at hop h always
// comes with every segment at lower hops, so a truncated output still
// reconstructs every path it contains. path_segment_count and
// path_segments_truncated say when the cap bit.

CREATE QUERY wcc_shared_origin_v1(
  STRING seed_card_id,
  STRING anchor_ts,
  STRING as_of_ts,
  INT window_hours = 168,
  INT max_hops = 1,
  INT stop_expanding_above = 200,
  INT max_device_cards = 5,
  INT max_device_rows = 20000,
  INT max_path_segments = 500
) FOR GRAPH HHGOAFraud {
  TYPEDEF TUPLE<STRING from_card, STRING device_id, STRING to_card, INT hop> PathSegment;

  OrAccum @visited;
  SumAccum<INT> @hop;
  SetAccum<STRING> @via_devices;
  SetAccum<STRING> @via_from_cards;

  SetAccum<STRING> @in_window_card_set;
  OrAccum @eligibility_computed;
  OrAccum @device_eligible;
  OrAccum @device_over_budget;
  OrAccum @device_considered;

  SetAccum<PathSegment> @@all_segments;
  HeapAccum<PathSegment>(max_path_segments, hop ASC, to_card ASC, from_card ASC, device_id ASC)
    @@returned_segments;

  SetAccum<STRING> @@component_cards;
  SetAccum<STRING> @@linking_devices;
  SetAccum<STRING> @@fraud_cards;
  SumAccum<INT> @@hops_run;
  SumAccum<INT> @@devices_considered;
  SumAccum<INT> @@devices_over_budget;
  BOOL expansion_stopped_early = FALSE;

  DATETIME anchor = to_datetime(anchor_ts);
  DATETIME as_of = to_datetime(as_of_ts);
  DATETIME effective_cutoff = anchor;
  IF datetime_to_epoch(as_of) < datetime_to_epoch(anchor) THEN
    effective_cutoff = as_of;
  END;
  INT anchor_epoch = datetime_to_epoch(anchor);
  INT window_seconds = window_hours * 3600;

  PRINT seed_card_id AS seed_card_id;
  PRINT anchor_ts AS anchor_ts, as_of_ts AS as_of_ts;
  PRINT effective_cutoff AS effective_cutoff;
  PRINT window_hours AS window_hours;
  PRINT max_device_cards AS device_card_threshold;
  PRINT stop_expanding_above AS stop_expanding_above;

  CARDS = {PaymentCard.*};
  DEVICES = {DeviceProfile.*};

  seed = SELECT c FROM CARDS:c WHERE c.card_id == seed_card_id
    ACCUM c.@visited = TRUE, c.@hop = 0
    POST-ACCUM @@component_cards += c.card_id;

  frontier = seed;

  WHILE frontier.size() > 0 AND @@hops_run < max_hops AND NOT expansion_stopped_early DO
    @@hops_run += 1;

    // Devices this frontier actually reaches in-window, not every device.
    candidates = SELECT d
      FROM frontier:c -(MADE>)- Transaction:t -(FROM_DEVICE>)- DeviceProfile:d
      WHERE t.ts <= effective_cutoff
        AND abs(datetime_to_epoch(t.ts) - anchor_epoch) <= window_seconds
        AND NOT d.@eligibility_computed
      ACCUM d.@device_considered += TRUE;

    // Resource precheck before any per-device counting.
    gated = SELECT d FROM candidates:d
      ACCUM CASE WHEN d.n_transactions > max_device_rows
        THEN d.@device_over_budget += TRUE END;

    within_budget = SELECT d FROM candidates:d WHERE NOT d.@device_over_budget;

    // DISTINCT CARDS in-window, which is what the threshold is named after.
    counted = SELECT d FROM within_budget:d -(DEVICE_USED_IN>)- Transaction:t
      WHERE t.ts <= effective_cutoff
        AND abs(datetime_to_epoch(t.ts) - anchor_epoch) <= window_seconds
      ACCUM d.@in_window_card_set += t.card_id;

    decided = SELECT d FROM candidates:d
      POST-ACCUM
        d.@eligibility_computed = TRUE,
        CASE WHEN d.@in_window_card_set.size() >= 2
              AND d.@in_window_card_set.size() <= max_device_cards
          THEN d.@device_eligible = TRUE END;

    frontier = SELECT c2
      FROM frontier:c1 -(MADE>)- Transaction:t1
           -(FROM_DEVICE>)- DeviceProfile:d
           -(DEVICE_USED_IN>)- Transaction:t2
           -(MADE_BY>)- PaymentCard:c2
      WHERE d.@device_eligible
        AND NOT c2.@visited
        AND t1.ts <= effective_cutoff
        AND t2.ts <= effective_cutoff
        AND abs(datetime_to_epoch(t1.ts) - anchor_epoch) <= window_seconds
        AND abs(datetime_to_epoch(t2.ts) - anchor_epoch) <= window_seconds
      ACCUM
        c2.@via_devices += d.device_id,
        c2.@via_from_cards += c1.card_id,
        @@all_segments += PathSegment(c1.card_id, d.device_id, c2.card_id, @@hops_run),
        @@linking_devices += d.device_id
      POST-ACCUM
        c2.@visited = TRUE,
        c2.@hop = @@hops_run,
        @@component_cards += c2.card_id;

    IF @@component_cards.size() > stop_expanding_above THEN
      expansion_stopped_early = TRUE;
    END;
  END;

  tally = SELECT d FROM DEVICES:d WHERE d.@device_considered
    ACCUM
      @@devices_considered += 1,
      CASE WHEN d.@device_over_budget THEN @@devices_over_budget += 1 END;

  PRINT @@hops_run AS hops_run;
  PRINT expansion_stopped_early AS expansion_stopped_early;
  PRINT @@component_cards.size() AS component_size;
  PRINT @@component_cards AS component_cards;
  PRINT @@linking_devices AS linking_devices;
  PRINT @@devices_considered AS devices_considered;
  PRINT @@devices_over_budget AS devices_skipped_over_budget;

  // Fraud enrichment over the component. A component of unremarkable cards and
  // one where half the members are known fraud are different findings, and size
  // alone cannot tell them apart.
  component_set = SELECT c FROM CARDS:c WHERE c.@visited;
  component_fraud = SELECT k FROM component_set:c -(CARD_HAS_CASE>)- ClosedCase:k
    WHERE k.closed_at <= effective_cutoff AND k.outcome == "confirmed_fraud"
    ACCUM @@fraud_cards += k.card_id;

  PRINT @@fraud_cards.size() AS component_cards_with_confirmed_fraud;
  PRINT @@fraud_cards AS fraud_enriched_cards;
  PRINT component_fraud[
    component_fraud.case_id, component_fraud.card_id, component_fraud.pattern,
    component_fraud.closed_at
  ] AS component_prior_fraud_cases;

  members = SELECT c FROM CARDS:c WHERE c.@visited AND c.card_id != seed_card_id;
  PRINT members[members.card_id, members.customer_id, members.@hop AS hop,
                members.@via_devices AS via_devices,
                members.@via_from_cards AS via_from_cards] AS component_members;

  // Exact predecessor-device-member segments, capped with lower hops first.
  FOREACH segment IN @@all_segments DO
    @@returned_segments += segment;
  END;
  PRINT @@all_segments.size() AS path_segment_count;
  PRINT @@returned_segments.size() AS path_segments_returned;
  PRINT (@@all_segments.size() > @@returned_segments.size()) AS path_segments_truncated;
  PRINT max_path_segments AS path_segment_cap;
  PRINT @@returned_segments AS path_segments;

  linking = SELECT d FROM DEVICES:d WHERE d.@device_eligible;
  PRINT linking[linking.device_id, linking.label, linking.signature_strength,
                linking.@in_window_card_set AS in_window_card_set]
    AS eligible_devices;
}
