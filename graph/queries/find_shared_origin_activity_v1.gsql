// find_shared_origin_activity_v1
//
// Which other cards used the same device, region or recipient email close in
// time to this case, and do any of them carry confirmed fraud?
//
// This is the query most able to invent a fraud ring that is not there, so its
// controls are the substance.
//
// ---------------------------------------------------------------------------
// EFFECTIVE EVIDENCE CUTOFF
// ---------------------------------------------------------------------------
// Everything below is bounded by effective_cutoff = min(anchor_ts, as_of_ts),
// not by as_of_ts alone.
//
// The two differ whenever a case is reviewed later than it was triggered. Using
// as_of_ts let a later review surface transactions, connected cards and
// confirmed-fraud outcomes that did not exist when the alert fired, which is
// exactly the evidence an investigator could not have had. The cutoff applies
// identically to the rarity count, the shared transactions and the fraud
// enrichment, so no one of them can reintroduce the future the others exclude.
//
// ---------------------------------------------------------------------------
// HONEST BOUNDING
// ---------------------------------------------------------------------------
// GSQL runs ACCUM over every matched vertex and applies LIMIT only to the
// returned set, so a LIMIT does not bound traversal work. An earlier version
// claimed a scan budget it did not have: with the budget set to 5, the scan
// still walked 45,521 rows for gmail.com.
//
// Work is therefore bounded BEFORE any traversal, by an O(1) precheck against
// the entity's stored lifetime transaction count. An entity whose lifetime
// volume exceeds max_scan_rows is refused without being scanned at all.
//
// That stored figure is a RESOURCE measure and never case evidence. It is
// reported as precheck_lifetime_transactions to keep the distinction visible,
// it decides only whether a scan is affordable, and no claim about the case may
// rest on it. The rarity that drives the supernode decision is counted to the
// effective cutoff.
//
// ---------------------------------------------------------------------------
// The remaining controls
// ---------------------------------------------------------------------------
// * Supernodes. The Gate 0 audit measured gmail.com touching 9,332 cards and
//   billing region 299.0 touching 2,075, against a median of 1-2 for a strong
//   device signature. Sharing such an entity says nothing about coordination.
//   The default threshold is 100: the audit put the 99th percentile of
//   cards-per-device at 137 for signatures of strength 3 or more. Gate 3 tunes
//   it with the other detection thresholds.
// * Time locality. Only activity within window_hours of the anchor counts.
// * Fraud enrichment, reported separately from degree, and only for cases
//   already closed as confirmed fraud at the effective cutoff.
//
// Degree, rarity, time locality and fraud enrichment come back as separate
// facts so a claim can rest on the combination policy R6 requires, never on
// degree alone.

CREATE QUERY find_shared_origin_activity_v1(
  STRING entity_kind,          // "device" | "region" | "recipient_email"
  STRING entity_id,
  STRING anchor_ts,
  STRING as_of_ts,
  STRING exclude_card_id = "",
  INT window_hours = 168,
  INT max_entity_cards = 100,
  INT max_rows = 400,
  INT max_scan_rows = 20000
) FOR GRAPH HHGOAFraud {
  DATETIME anchor = to_datetime(anchor_ts);
  DATETIME as_of = to_datetime(as_of_ts);

  // The earlier of the two bounds everything.
  DATETIME effective_cutoff = anchor;
  IF datetime_to_epoch(as_of) < datetime_to_epoch(anchor) THEN
    effective_cutoff = as_of;
  END;
  INT anchor_epoch = datetime_to_epoch(anchor);

  SumAccum<INT> @@precheck_rows;
  SetAccum<STRING> @@entity_cards_to_cutoff;
  SumAccum<INT> @@rarity_rows;
  SumAccum<INT> @@window_transactions;
  SetAccum<STRING> @@window_cards;
  SetAccum<STRING> @@fraud_cards;

  BOOL refused = FALSE;
  BOOL over_budget = FALSE;
  BOOL too_common = FALSE;
  BOOL unknown_entity = FALSE;

  DEVICES = {DeviceProfile.*};
  REGIONS = {BillingRegion.*};
  EMAILS = {EmailDomain.*};

  // Resource precheck only. n_transactions is a lifetime figure, used here
  // solely to decide whether scanning this entity is affordable.
  device = SELECT d FROM DEVICES:d
    WHERE entity_kind == "device" AND d.device_id == entity_id
    POST-ACCUM @@precheck_rows += d.n_transactions;
  region = SELECT r FROM REGIONS:r
    WHERE entity_kind == "region" AND r.region_code == entity_id
    POST-ACCUM @@precheck_rows += r.n_transactions;
  email = SELECT e FROM EMAILS:e
    WHERE entity_kind == "recipient_email" AND e.domain == entity_id
    POST-ACCUM @@precheck_rows += e.n_transactions;

  // An unknown kind or id would otherwise scan nothing and return zero
  // co-occurrence, which reads as "rare and unshared" -- a finding, not the
  // absence of one.
  IF device.size() + region.size() + email.size() == 0 THEN
    unknown_entity = TRUE;
    refused = TRUE;
  END;

  IF @@precheck_rows > max_scan_rows THEN
    over_budget = TRUE;
    refused = TRUE;
  END;

  PRINT entity_kind AS entity_kind, entity_id AS entity_id;
  PRINT anchor_ts AS anchor_ts, as_of_ts AS as_of_ts;
  PRINT effective_cutoff AS effective_cutoff;
  PRINT max_entity_cards AS supernode_threshold;
  PRINT max_scan_rows AS scan_row_budget;
  PRINT @@precheck_rows AS precheck_lifetime_transactions;
  PRINT over_budget AS refused_over_scan_budget;
  PRINT unknown_entity AS refused_unknown_entity;

  IF NOT over_budget AND NOT unknown_entity THEN
    // Affordable by construction: the precheck established the row count.
    rarity_device = SELECT t FROM device:d -(DEVICE_USED_IN>)- Transaction:t
      WHERE t.ts <= effective_cutoff
      ACCUM @@entity_cards_to_cutoff += t.card_id, @@rarity_rows += 1;
    rarity_region = SELECT t FROM region:r -(BILLS>)- Transaction:t
      WHERE t.ts <= effective_cutoff
      ACCUM @@entity_cards_to_cutoff += t.card_id, @@rarity_rows += 1;
    rarity_email = SELECT t FROM email:e -(RECEIVED_BY_DOMAIN>)- Transaction:t
      WHERE t.ts <= effective_cutoff
      ACCUM @@entity_cards_to_cutoff += t.card_id, @@rarity_rows += 1;

    IF @@entity_cards_to_cutoff.size() > max_entity_cards THEN
      too_common = TRUE;
      refused = TRUE;
    END;
  END;

  PRINT @@entity_cards_to_cutoff.size() AS entity_cards_to_cutoff;
  PRINT @@rarity_rows AS rarity_rows_scanned;
  PRINT too_common AS refused_as_supernode;
  PRINT refused AS refused;

  IF unknown_entity THEN
    PRINT "no entity of this kind has this id (kinds: device, region, recipient_email)" AS refusal_reason;
  ELSE IF over_budget THEN
    PRINT "entity volume exceeds the scan budget, so its rarity cannot be established affordably" AS refusal_reason;
  ELSE
    IF too_common THEN
      PRINT "entity is shared too widely at the cutoff for co-occurrence to imply coordination" AS refusal_reason;
    ELSE
      entity_txns = SELECT t FROM device:d -(DEVICE_USED_IN>)- Transaction:t
        WHERE t.ts <= effective_cutoff
          AND abs(datetime_to_epoch(t.ts) - anchor_epoch) <= window_hours * 3600
          AND t.card_id != exclude_card_id
        ACCUM @@window_transactions += 1, @@window_cards += t.card_id
        LIMIT max_rows;

      region_txns = SELECT t FROM region:r -(BILLS>)- Transaction:t
        WHERE t.ts <= effective_cutoff
          AND abs(datetime_to_epoch(t.ts) - anchor_epoch) <= window_hours * 3600
          AND t.card_id != exclude_card_id
        ACCUM @@window_transactions += 1, @@window_cards += t.card_id
        LIMIT max_rows;

      email_txns = SELECT t FROM email:e -(RECEIVED_BY_DOMAIN>)- Transaction:t
        WHERE t.ts <= effective_cutoff
          AND abs(datetime_to_epoch(t.ts) - anchor_epoch) <= window_hours * 3600
          AND t.card_id != exclude_card_id
        ACCUM @@window_transactions += 1, @@window_cards += t.card_id
        LIMIT max_rows;

      shared = entity_txns UNION region_txns UNION email_txns;

      PRINT @@window_transactions AS transactions_in_window;
      PRINT @@window_cards AS cards_in_window;
      PRINT @@window_cards.size() AS distinct_cards_in_window;
      PRINT shared[
        shared.txn_id, shared.ts, shared.amount, shared.card_id,
        shared.customer_id, shared.channel, shared.risk_score
      ] AS shared_transactions;
      // The sample is capped at max_rows per entity; the counts above are not.
      PRINT shared.size() AS shared_transactions_returned;
      PRINT (@@window_transactions > shared.size()) AS shared_transactions_truncated;

      // Fraud enrichment is measured over EVERY in-window card, not only the
      // cards in the capped sample, so the cap cannot understate enrichment.
      // At most max_entity_cards cards reach here, since a wider entity is
      // refused as a supernode above.
      ALL_CARDS = {PaymentCard.*};
      connected_cards = SELECT c FROM ALL_CARDS:c WHERE @@window_cards.contains(c.card_id);

      // Only fraud already confirmed at the effective cutoff. An outcome
      // reached afterwards is not evidence the investigator could have had.
      fraud_cases = SELECT k FROM connected_cards:c -(CARD_HAS_CASE>)- ClosedCase:k
        WHERE k.closed_at <= effective_cutoff AND k.outcome == "confirmed_fraud"
        ACCUM @@fraud_cards += k.card_id;

      PRINT @@fraud_cards AS cards_with_confirmed_fraud;
      PRINT @@fraud_cards.size() AS fraud_enriched_card_count;
      PRINT fraud_cases[
        fraud_cases.case_id, fraud_cases.card_id, fraud_cases.pattern,
        fraud_cases.closed_at, fraud_cases.exposure_usd
      ] AS prior_fraud_cases;
    END;
  END;
}
