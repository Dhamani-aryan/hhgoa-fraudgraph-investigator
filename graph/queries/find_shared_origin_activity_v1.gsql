// find_shared_origin_activity_v1
//
// Which other cards used the same device, region or recipient email close in
// time to this case, and do any of them carry confirmed fraud?
//
// This is the query most able to invent a fraud ring that is not there, so the
// controls are the point:
//
// * Supernodes. The Gate 0 audit measured gmail.com touching 9,332 cards and
//   billing region 299.0 touching 2,075, while a strong device signature has a
//   median of 1-2. An entity whose global card count exceeds max_entity_cards
//   is refused outright and reported as refused, because sharing it says
//   nothing about coordination.
// * Time locality. Only activity inside window_hours of the anchor counts, so
//   a device shared across six months is not read as a ring.
// * Rarity. The entity's global card count comes back with the result, so the
//   caller can weigh a device seen on 3 cards differently from one seen on 800.
// * Fraud enrichment. Connected cards are reported with whether they carry a
//   closed case already confirmed as fraud at the anchor time.
// * Bounded expansion. Every hop is capped.
//
// The caller still has to decide. This query supplies degree, rarity, time
// locality and fraud enrichment separately so a claim can rest on the
// combination the policy requires, never on degree alone.

CREATE QUERY find_shared_origin_activity_v1(
  STRING entity_kind,          // "device" | "region" | "recipient_email"
  STRING entity_id,
  STRING anchor_ts,
  STRING as_of_ts,
  STRING exclude_card_id = "",
  INT window_hours = 168,
  INT max_entity_cards = 250,
  INT max_rows = 400
) FOR GRAPH HHGOAFraud {
  DATETIME anchor = to_datetime(anchor_ts);
  DATETIME cutoff = to_datetime(as_of_ts);
  INT anchor_epoch = datetime_to_epoch(anchor);

  SumAccum<INT> @@entity_total_cards;
  SumAccum<INT> @@window_transactions;
  SetAccum<STRING> @@window_cards;
  SetAccum<STRING> @@fraud_cards;
  BOOL refused_supernode = FALSE;

  // Resolve the shared entity and read its global card count, which is the
  // rarity measure the supernode control keys on.
  DEVICES = {DeviceProfile.*};
  REGIONS = {BillingRegion.*};
  EMAILS = {EmailDomain.*};

  device = SELECT d FROM DEVICES:d
    WHERE entity_kind == "device" AND d.device_id == entity_id
    POST-ACCUM @@entity_total_cards += d.n_cards;

  region = SELECT r FROM REGIONS:r
    WHERE entity_kind == "region" AND r.region_code == entity_id
    POST-ACCUM @@entity_total_cards += r.n_cards;

  email = SELECT e FROM EMAILS:e
    WHERE entity_kind == "recipient_email" AND e.domain == entity_id
    POST-ACCUM @@entity_total_cards += e.n_cards;

  PRINT entity_kind AS entity_kind, entity_id AS entity_id;
  PRINT @@entity_total_cards AS entity_total_cards;
  PRINT max_entity_cards AS supernode_threshold;

  IF @@entity_total_cards > max_entity_cards THEN
    refused_supernode = TRUE;
  END;

  PRINT refused_supernode AS refused_as_supernode;

  IF refused_supernode THEN
    PRINT "entity is shared too widely for co-occurrence to imply coordination"
      AS refusal_reason;
  ELSE
    // Transactions on the entity, inside the window and at or before the anchor.
    entity_txns = SELECT t FROM device:d -(DEVICE_USED_IN>)- Transaction:t
      WHERE t.ts <= cutoff
        AND abs(datetime_to_epoch(t.ts) - anchor_epoch) <= window_hours * 3600
        AND t.card_id != exclude_card_id
      ACCUM @@window_transactions += 1, @@window_cards += t.card_id
      LIMIT max_rows;

    region_txns = SELECT t FROM region:r -(BILLS>)- Transaction:t
      WHERE t.ts <= cutoff
        AND abs(datetime_to_epoch(t.ts) - anchor_epoch) <= window_hours * 3600
        AND t.card_id != exclude_card_id
      ACCUM @@window_transactions += 1, @@window_cards += t.card_id
      LIMIT max_rows;

    email_txns = SELECT t FROM email:e -(RECEIVED_BY_DOMAIN>)- Transaction:t
      WHERE t.ts <= cutoff
        AND abs(datetime_to_epoch(t.ts) - anchor_epoch) <= window_hours * 3600
        AND t.card_id != exclude_card_id
      ACCUM @@window_transactions += 1, @@window_cards += t.card_id
      LIMIT max_rows;

    shared = entity_txns UNION region_txns UNION email_txns;

    PRINT @@window_transactions AS transactions_in_window;
    PRINT @@window_cards AS cards_in_window;
    PRINT @@window_cards.size() AS distinct_cards_in_window;

    PRINT shared[
      shared.txn_id, shared.ts, shared.amount, shared.card_id,
      shared.customer_id, shared.channel, shared.risk_score
    ] AS shared_transactions;

    // Fraud enrichment: which of those cards already carried a case confirmed
    // as fraud by the anchor time. A case closed after the anchor is not
    // evidence the investigator could have had.
    connected_cards = SELECT c FROM shared:t -(MADE_BY>)- PaymentCard:c;

    fraud_cases = SELECT k FROM connected_cards:c -(CARD_HAS_CASE>)- ClosedCase:k
      WHERE k.closed_at <= cutoff AND k.outcome == "confirmed_fraud"
      ACCUM @@fraud_cards += k.card_id;

    PRINT @@fraud_cards AS cards_with_confirmed_fraud;
    PRINT @@fraud_cards.size() AS fraud_enriched_card_count;
    PRINT fraud_cases[
      fraud_cases.case_id, fraud_cases.card_id, fraud_cases.pattern,
      fraud_cases.closed_at, fraud_cases.exposure_usd
    ] AS prior_fraud_cases;
  END;
}
