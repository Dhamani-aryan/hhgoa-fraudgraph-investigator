// get_case_context_v1
//
// The trigger package: the flagged transaction and everything one hop from it.
//
// ---------------------------------------------------------------------------
// EFFECTIVE EVIDENCE CUTOFF
// ---------------------------------------------------------------------------
// Everything is bounded by effective_cutoff = min(flagged transaction ts,
// as_of_ts), and the same bound is applied to card history, cardholder
// history, device history, adjacent transactions and prior closed cases.
//
// as_of_ts alone is not enough. It equals the anchor only when a case is
// reviewed the moment it is triggered; any later review would otherwise widen
// every one of those five traversals and show the investigator activity that
// came after the alert. Bounding by the flagged transaction's own timestamp
// makes the evidence a property of the case rather than of when someone
// happened to look at it.
//
// The query refuses outright when the flagged transaction postdates as_of_ts,
// or when it does not exist. A caller asking about a transaction that had not
// happened has a bug, and answering would hand it the future.
//
// ---------------------------------------------------------------------------
// NO STORED AGGREGATE IS RETURNED AS EVIDENCE
// ---------------------------------------------------------------------------
// Card.n_transactions, Cardholder.last_seen, DeviceProfile.n_cards and the like
// are computed over the whole six-month dataset at load time. An earlier
// version answered a 2016-11-11 case with last_seen 2016-12-25 and a lifetime
// count of 59 against the 53 that existed at the anchor. Every count here is
// recomputed by traversal to the effective cutoff, and those attributes are not
// printed.
//
// ---------------------------------------------------------------------------
// BOUNDING
// ---------------------------------------------------------------------------
// GSQL runs ACCUM over every matched vertex and applies LIMIT only to the
// returned set, so a LIMIT does not bound traversal work. The device scan is
// therefore gated by an O(1) precheck against the device's stored lifetime
// transaction count and skipped when that exceeds max_scan_rows.
//
// That stored figure is a RESOURCE measure, never case evidence: it is
// reported as device_precheck_lifetime_transactions, it decides only whether a
// scan is affordable, and every count that is evidence is bounded by the
// effective cutoff.
//
// The card and cardholder scans carry no budget and claim none. The largest
// card in this dataset holds 14,891 transactions and the 99th percentile is
// 726, so both are affordable by construction.

CREATE QUERY get_case_context_v1(
  STRING flagged_txn_id,
  STRING as_of_ts,
  INT max_adjacent = 40,
  INT max_scan_rows = 20000
) FOR GRAPH HHGOAFraud {
  DATETIME as_of = to_datetime(as_of_ts);
  DATETIME flagged_ts;
  BOOL found = FALSE;
  BOOL after_cutoff = FALSE;

  SumAccum<INT> @@card_txns, @@holder_txns;
  MinAccum<DATETIME> @@card_first_seen;
  MaxAccum<DATETIME> @@card_last_seen;
  SumAccum<INT> @@device_txns;
  SetAccum<STRING> @@device_cards;
  SumAccum<INT> @@device_precheck_rows;
  BOOL device_scan_skipped = FALSE;

  SEED = {Transaction.*};
  flagged = SELECT t FROM SEED:t WHERE t.txn_id == flagged_txn_id
    POST-ACCUM found = TRUE, flagged_ts = t.ts;

  IF found AND datetime_to_epoch(flagged_ts) > datetime_to_epoch(as_of) THEN
    after_cutoff = TRUE;
  END;
  BOOL refused = (NOT found) OR after_cutoff;

  // min(flagged ts, as_of). The refusal above makes as_of the larger of the
  // two whenever the request is admissible, but the min is computed rather
  // than assumed so the bound cannot drift if that guard ever changes.
  DATETIME effective_cutoff = as_of;
  IF found AND datetime_to_epoch(flagged_ts) < datetime_to_epoch(as_of) THEN
    effective_cutoff = flagged_ts;
  END;

  PRINT refused AS refused;
  PRINT after_cutoff AS flagged_after_cutoff;
  PRINT (NOT found) AS flagged_not_found;
  PRINT as_of_ts AS as_of_ts;

  IF refused THEN
    IF after_cutoff THEN
      PRINT "the flagged transaction postdates as_of_ts, so it is not yet visible" AS refusal_reason;
    ELSE
      PRINT "the flagged transaction does not exist" AS refusal_reason;
    END;
  ELSE
    PRINT effective_cutoff AS effective_cutoff;

    PRINT flagged[
      flagged.txn_id, flagged.ts, flagged.amount, flagged.product_cd,
      flagged.channel, flagged.risk_score, flagged.addr1, flagged.addr2,
      flagged.p_email_domain, flagged.r_email_domain,
      flagged.card_id, flagged.customer_id
    ] AS flagged_transaction;

    card = SELECT c FROM flagged:t -(MADE_BY>)- PaymentCard:c;
    PRINT card[card.card_id, card.customer_id, card.card_type, card.card_network]
      AS card;

    holder = SELECT h FROM card:c -(OWNED_BY>)- Cardholder:h;
    PRINT holder[holder.customer_id] AS cardholder;

    card_history = SELECT t FROM card:c -(MADE>)- Transaction:t
      WHERE t.ts <= effective_cutoff
      ACCUM @@card_txns += 1, @@card_first_seen += t.ts, @@card_last_seen += t.ts;
    PRINT @@card_txns AS card_transactions_to_anchor;
    PRINT @@card_first_seen AS card_first_seen_to_anchor;
    PRINT @@card_last_seen AS card_last_seen_to_anchor;

    holder_history = SELECT t FROM holder:h -(OWNS>)- PaymentCard:c -(MADE>)- Transaction:t
      WHERE t.ts <= effective_cutoff
      ACCUM @@holder_txns += 1;
    PRINT @@holder_txns AS cardholder_transactions_to_anchor;

    device = SELECT d FROM flagged:t -(FROM_DEVICE>)- DeviceProfile:d
      POST-ACCUM @@device_precheck_rows += d.n_transactions;
    IF @@device_precheck_rows > max_scan_rows THEN
      device_scan_skipped = TRUE;
    END;

    PRINT device[
      device.device_id, device.label, device.device_type, device.new_or_found,
      device.proxy_category, device.match_status, device.signature_strength
    ] AS device;
    PRINT @@device_precheck_rows AS device_precheck_lifetime_transactions;
    PRINT max_scan_rows AS scan_row_budget;
    PRINT device_scan_skipped AS device_scan_skipped;

    IF NOT device_scan_skipped THEN
      device_history = SELECT t FROM device:d -(DEVICE_USED_IN>)- Transaction:t
        WHERE t.ts <= effective_cutoff
        ACCUM @@device_txns += 1, @@device_cards += t.card_id;
      PRINT @@device_txns AS device_transactions_to_anchor;
      PRINT @@device_cards.size() AS device_cards_to_anchor;
    END;

    region = SELECT r FROM flagged:t -(BILLED_IN>)- BillingRegion:r;
    PRINT region[region.region_code, region.country_code] AS billing_region;

    purchaser = SELECT e FROM flagged:t -(PURCHASER_EMAIL>)- EmailDomain:e;
    PRINT purchaser[purchaser.domain] AS purchaser_email;

    recipient = SELECT e FROM flagged:t -(RECIPIENT_EMAIL>)- EmailDomain:e;
    PRINT recipient[recipient.domain] AS recipient_email;

    adjacent = SELECT t FROM card:c -(MADE>)- Transaction:t
      WHERE t.txn_id != flagged_txn_id AND t.ts <= effective_cutoff
      ORDER BY t.ts DESC
      LIMIT max_adjacent;
    PRINT adjacent[
      adjacent.txn_id, adjacent.ts, adjacent.amount, adjacent.product_cd,
      adjacent.channel, adjacent.risk_score, adjacent.addr1
    ] AS adjacent_transactions;

    prior = SELECT k FROM card:c -(CARD_HAS_CASE>)- ClosedCase:k
      WHERE k.closed_at <= effective_cutoff;
    PRINT prior[
      prior.case_id, prior.outcome, prior.pattern, prior.closed_at,
      prior.exposure_usd
    ] AS prior_cases_on_card;
  END;
}
