// extract_temporal_graph_features_v1
//
// The interpretable graph feature vector for one case, every value computed to
// the effective cutoff.
//
// Deliberately a small set of named, explainable numbers rather than an
// embedding. A scorer that cannot say which feature moved a probability cannot
// be defended to an analyst, and the build plan puts FastRP and node2vec out of
// scope for this deadline.
//
// ---------------------------------------------------------------------------
// TEMPORAL RULE
// ---------------------------------------------------------------------------
// effective_cutoff = min(flagged transaction ts, as_of_ts). Every degree, every
// count and every neighbour outcome is measured at or before it, so the vector
// describes the graph as it stood when the alert fired. A feature computed over
// the whole dataset would make an offline evaluation look far better than the
// runtime it is meant to predict.
//
// The query refuses a flagged transaction that postdates as_of_ts, or one that
// does not exist, and returns no features at all in that case.
//
// ---------------------------------------------------------------------------
// BOUNDING
// ---------------------------------------------------------------------------
// Each shared-entity section -- device, billing region, purchaser email -- is
// gated by its own O(1) precheck against the entity's stored lifetime
// transaction count, and SKIPPED when that exceeds max_scan_rows. A skipped
// section returns none of its features, never a partial count: a degree read
// from half an entity's history would look like a real, small degree and
// nothing downstream could tell it apart. Each section reports
// <entity>_precheck_lifetime_transactions, <entity>_scan_skipped and
// <entity>_rows_scanned, which is 0 whenever the section was skipped.
//
// An earlier version gated only the device. Measured on HHG-017 with the
// default max_scan_rows of 20,000, the region section still traversed 31,813
// transactions and the email section 28,793, so the budget bounded nothing for
// the two entities most likely to be supernodes.
//
// The lifetime figures are RESOURCE measures, never features and never case
// evidence: they decide only whether a scan is affordable and are reported
// under names ending precheck_lifetime_transactions so an evidence assembler
// can drop them by name. The features themselves are all cutoff-bounded
// counts. EmailDomain.n_transactions sums purchaser AND recipient rows, so for
// the purchaser scan it is a conservative upper bound: it can skip a scan that
// would have fitted, never admit one that would not.
//
// The card's own history (velocity, burst count, region novelty) is not gated
// by max_scan_rows. It is bounded by the data instead: the largest card holds
// 14,891 transactions, below the 20,000 default, the figure get_card_baseline_v1
// gates on and a unit test pins against the prepared files.
//
// Windowed degrees use 1h, 24h, 7d and to-cutoff, which is the range over which
// card testing, bursts and slow compromise respectively become visible.
//
// ---------------------------------------------------------------------------
// COVERAGE AGAINST THE PLAN'S FEATURE LIST
// ---------------------------------------------------------------------------
// This query does NOT return the plan's whole feature vector on its own. It
// returns the part that is one traversal from the flagged transaction; the
// remainder is returned by other installed queries and is to be composed into
// one vector by the GraphRAG / feature assembler, which is not built yet. A
// caller holding only this query's output does not have the values listed
// under "not returned here".
//
// Returned here, when the section's budget allows:
//   device, email and region degree at 1h / 24h / 7d / to-cutoff
//   distinct cards in the window on the device, region and email, and
//     distinct customers on the device
//   count AND recency of confirmed-fraud and cleared neighbours on the device
//   burst count, region novelty, device novelty
//
// Not returned here -- only a raw input, or computed by another query:
//   shared-entity rarity and fraud enrichment: only their inputs are here
//     (in-window distinct cards, neighbour outcome counts). The
//     cutoff-bounded rarity and supernode decision is made by
//     find_shared_origin_activity_v1; no enrichment ratio is computed yet.
//   amount MAD and robust amount percentiles: from the amount list returned
//     by get_card_baseline_v1, to be computed in Python where a zero MAD can
//     be handled explicitly. GSQL has no median.
//   time-local weakly connected component size, two-hop reachability and the
//     capped provenance paths: from wcc_shared_origin_v1, the graph
//     algorithm, which returns predecessor-device-member path segments.
//   home-region overlap: from find_region_anomalies_v1, which separates a
//     trip from a clone by reporting concurrent activity in another region.
//   region and email degrees for an entity over budget: withheld, see
//     BOUNDING. The scan-skipped flag is itself the supernode signal.

CREATE QUERY extract_temporal_graph_features_v1(
  STRING flagged_txn_id,
  STRING as_of_ts,
  INT shared_window_hours = 168,
  INT burst_gap_seconds = 600,
  INT max_scan_rows = 20000
) FOR GRAPH HHGOAFraud {
  DATETIME as_of = to_datetime(as_of_ts);
  DATETIME flagged_ts;
  BOOL found = FALSE;
  BOOL after_cutoff = FALSE;

  SumAccum<INT> @@card_1h, @@card_24h, @@card_7d, @@card_to_cutoff;
  SumAccum<INT> @@device_1h, @@device_24h, @@device_7d, @@device_to_cutoff;
  SetAccum<STRING> @@device_cards_window;
  SetAccum<STRING> @@device_customers_window;
  SumAccum<INT> @@region_to_cutoff;
  SetAccum<STRING> @@region_cards_window;
  SumAccum<INT> @@region_1h, @@region_24h, @@region_7d, @@region_all;
  SumAccum<INT> @@email_1h, @@email_24h, @@email_7d, @@email_all;
  SetAccum<STRING> @@email_cards_window;
  SumAccum<INT> @@burst_count;
  MaxAccum<DATETIME> @@latest_cleared_neighbour_closure;
  SumAccum<INT> @@card_region_prior;
  SumAccum<INT> @@card_device_prior;
  SetAccum<STRING> @@fraud_neighbour_cards;
  SetAccum<STRING> @@cleared_neighbour_cards;
  MaxAccum<DATETIME> @@latest_fraud_neighbour_closure;
  SumAccum<INT> @@device_precheck_rows;
  BOOL device_scan_skipped = FALSE;
  SumAccum<INT> @@region_precheck_rows, @@email_precheck_rows;
  SumAccum<INT> @@device_rows_scanned, @@region_rows_scanned, @@email_rows_scanned;
  BOOL region_scan_skipped = FALSE;
  BOOL email_scan_skipped = FALSE;

  SEED = {Transaction.*};
  flagged = SELECT t FROM SEED:t WHERE t.txn_id == flagged_txn_id
    POST-ACCUM found = TRUE, flagged_ts = t.ts;

  IF found AND datetime_to_epoch(flagged_ts) > datetime_to_epoch(as_of) THEN
    after_cutoff = TRUE;
  END;
  BOOL refused = (NOT found) OR after_cutoff;

  DATETIME effective_cutoff = as_of;
  IF found AND datetime_to_epoch(flagged_ts) < datetime_to_epoch(as_of) THEN
    effective_cutoff = flagged_ts;
  END;
  INT cutoff_epoch = datetime_to_epoch(effective_cutoff);
  INT window_seconds = shared_window_hours * 3600;

  PRINT refused AS refused;
  PRINT (NOT found) AS flagged_not_found;
  PRINT after_cutoff AS flagged_after_cutoff;

  IF refused THEN
    PRINT "the flagged transaction is unknown or postdates as_of_ts" AS refusal_reason;
  ELSE
    PRINT effective_cutoff AS effective_cutoff;
    PRINT shared_window_hours AS shared_window_hours;

    STRING flagged_region = "";
    STRING flagged_card = "";
    probe = SELECT t FROM flagged:t
      POST-ACCUM flagged_region = t.addr1, flagged_card = t.card_id;
    PRINT flagged_card AS card_id;

    card = SELECT c FROM flagged:t -(MADE_BY>)- PaymentCard:c;

    // Card velocity at four scales.
    card_hist = SELECT t FROM card:c -(MADE>)- Transaction:t
      WHERE t.ts <= effective_cutoff
      ACCUM
        @@card_to_cutoff += 1,
        CASE WHEN datetime_to_epoch(t.ts) > cutoff_epoch - 3600 THEN @@card_1h += 1 END,
        CASE WHEN datetime_to_epoch(t.ts) > cutoff_epoch - 86400 THEN @@card_24h += 1 END,
        CASE WHEN datetime_to_epoch(t.ts) > cutoff_epoch - 604800 THEN @@card_7d += 1 END,
        CASE WHEN t.addr1 == flagged_region AND t.txn_id != flagged_txn_id
          THEN @@card_region_prior += 1 END;

    PRINT @@card_to_cutoff AS card_degree_to_cutoff;
    PRINT @@card_1h AS card_degree_1h, @@card_24h AS card_degree_24h,
          @@card_7d AS card_degree_7d;
    PRINT @@card_region_prior AS card_prior_transactions_in_flagged_region;
    PRINT (@@card_region_prior == 0) AS region_is_novel_for_card;

    // Device: degree, and how many other cards and customers it reached
    // inside the window. Distinct customers matters more than distinct cards,
    // since one person's two cards on one device is not a ring.
    device = SELECT d FROM flagged:t -(FROM_DEVICE>)- DeviceProfile:d
      POST-ACCUM @@device_precheck_rows += d.n_transactions;
    IF @@device_precheck_rows > max_scan_rows THEN
      device_scan_skipped = TRUE;
    END;

    PRINT @@device_precheck_rows AS device_precheck_lifetime_transactions;
    PRINT device_scan_skipped AS device_scan_skipped;
    PRINT device[device.device_id, device.new_or_found, device.signature_strength]
      AS device;

    IF NOT device_scan_skipped THEN
      device_hist = SELECT t FROM device:d -(DEVICE_USED_IN>)- Transaction:t
        WHERE t.ts <= effective_cutoff
        ACCUM
          @@device_rows_scanned += 1,
          @@device_to_cutoff += 1,
          CASE WHEN datetime_to_epoch(t.ts) > cutoff_epoch - 3600 THEN @@device_1h += 1 END,
          CASE WHEN datetime_to_epoch(t.ts) > cutoff_epoch - 86400 THEN @@device_24h += 1 END,
          CASE WHEN datetime_to_epoch(t.ts) > cutoff_epoch - 604800 THEN @@device_7d += 1 END,
          CASE WHEN abs(datetime_to_epoch(t.ts) - cutoff_epoch) <= window_seconds THEN
            @@device_cards_window += t.card_id,
            @@device_customers_window += t.customer_id
          END,
          CASE WHEN t.card_id == flagged_card AND t.txn_id != flagged_txn_id
            THEN @@card_device_prior += 1 END;

      PRINT @@device_to_cutoff AS device_degree_to_cutoff;
      PRINT @@device_1h AS device_degree_1h, @@device_24h AS device_degree_24h,
            @@device_7d AS device_degree_7d;
      PRINT @@device_cards_window.size() AS device_distinct_cards_in_window;
      PRINT @@device_customers_window.size() AS device_distinct_customers_in_window;
      PRINT @@card_device_prior AS card_prior_transactions_on_device;
      PRINT (@@card_device_prior == 0) AS device_is_novel_for_card;

      // Neighbour outcomes: cards sharing this device in-window that already
      // carried a closed case at the cutoff. Both outcomes are returned, so a
      // cleared neighbour can lower a score rather than only fraud raising it.
      neighbour_cards = SELECT c FROM device:d -(DEVICE_USED_IN>)- Transaction:t
        -(MADE_BY>)- PaymentCard:c
        WHERE t.ts <= effective_cutoff
          AND abs(datetime_to_epoch(t.ts) - cutoff_epoch) <= window_seconds
          AND c.card_id != flagged_card;

      neighbour_cases = SELECT k FROM neighbour_cards:c -(CARD_HAS_CASE>)- ClosedCase:k
        WHERE k.closed_at <= effective_cutoff
        ACCUM
          CASE WHEN k.outcome == "confirmed_fraud" THEN
            @@fraud_neighbour_cards += k.card_id,
            @@latest_fraud_neighbour_closure += k.closed_at
          END,
          CASE WHEN k.outcome == "cleared" THEN
            @@cleared_neighbour_cards += k.card_id,
            @@latest_cleared_neighbour_closure += k.closed_at END;

      PRINT @@fraud_neighbour_cards.size() AS device_fraud_neighbour_cards;
      PRINT @@cleared_neighbour_cards.size() AS device_cleared_neighbour_cards;
      PRINT @@fraud_neighbour_cards AS fraud_neighbour_card_ids;
      PRINT @@latest_fraud_neighbour_closure AS latest_fraud_neighbour_closure;
      // Recency matters for both outcomes: a fraud neighbour from last week and
      // one from four months ago are not the same evidence, and the same is
      // true of a neighbour that was investigated and cleared.
      PRINT @@latest_cleared_neighbour_closure AS latest_cleared_neighbour_closure;
    END;
    PRINT @@device_rows_scanned AS device_rows_scanned;

    // Region degree at the same four scales as the device, plus the in-window
    // reach the caller needs to discount a common billing region. Gated like
    // the device: a region over budget is skipped whole, never read in part.
    region = SELECT r FROM flagged:t -(BILLED_IN>)- BillingRegion:r
      POST-ACCUM @@region_precheck_rows += r.n_transactions;
    IF @@region_precheck_rows > max_scan_rows THEN
      region_scan_skipped = TRUE;
    END;
    PRINT @@region_precheck_rows AS region_precheck_lifetime_transactions;
    PRINT region_scan_skipped AS region_scan_skipped;

    IF NOT region_scan_skipped THEN
      region_hist = SELECT t FROM region:r -(BILLS>)- Transaction:t
        WHERE t.ts <= effective_cutoff
        ACCUM
          @@region_rows_scanned += 1,
          @@region_all += 1,
          CASE WHEN datetime_to_epoch(t.ts) > cutoff_epoch - 3600 THEN @@region_1h += 1 END,
          CASE WHEN datetime_to_epoch(t.ts) > cutoff_epoch - 86400 THEN @@region_24h += 1 END,
          CASE WHEN datetime_to_epoch(t.ts) > cutoff_epoch - 604800 THEN @@region_7d += 1 END,
          CASE WHEN abs(datetime_to_epoch(t.ts) - cutoff_epoch) <= window_seconds THEN
            @@region_to_cutoff += 1, @@region_cards_window += t.card_id END;

      PRINT @@region_all AS region_degree_to_cutoff;
      PRINT @@region_1h AS region_degree_1h, @@region_24h AS region_degree_24h,
            @@region_7d AS region_degree_7d;
      PRINT @@region_to_cutoff AS region_transactions_in_window;
      PRINT @@region_cards_window.size() AS region_distinct_cards_in_window;
    ELSE
      PRINT "billing region lifetime volume exceeds max_scan_rows; region features withheld, not partial"
        AS region_features_withheld_reason;
    END;
    PRINT @@region_rows_scanned AS region_rows_scanned;

    // Purchaser email domain, the third shared entity. Degrees at the same
    // scales, so a common free-mail domain can be discounted the same way, and
    // gated the same way: free-mail domains are the largest supernodes here.
    email = SELECT e FROM flagged:t -(PURCHASER_EMAIL>)- EmailDomain:e
      POST-ACCUM @@email_precheck_rows += e.n_transactions;
    IF @@email_precheck_rows > max_scan_rows THEN
      email_scan_skipped = TRUE;
    END;
    PRINT email[email.domain] AS purchaser_email_domain;
    PRINT @@email_precheck_rows AS email_precheck_lifetime_transactions;
    PRINT email_scan_skipped AS email_scan_skipped;

    IF NOT email_scan_skipped THEN
      email_hist = SELECT t FROM email:e -(PURCHASED_BY_DOMAIN>)- Transaction:t
        WHERE t.ts <= effective_cutoff
        ACCUM
          @@email_rows_scanned += 1,
          @@email_all += 1,
          CASE WHEN datetime_to_epoch(t.ts) > cutoff_epoch - 3600 THEN @@email_1h += 1 END,
          CASE WHEN datetime_to_epoch(t.ts) > cutoff_epoch - 86400 THEN @@email_24h += 1 END,
          CASE WHEN datetime_to_epoch(t.ts) > cutoff_epoch - 604800 THEN @@email_7d += 1 END,
          CASE WHEN abs(datetime_to_epoch(t.ts) - cutoff_epoch) <= window_seconds THEN
            @@email_cards_window += t.card_id END;

      PRINT @@email_all AS email_degree_to_cutoff;
      PRINT @@email_1h AS email_degree_1h, @@email_24h AS email_degree_24h,
            @@email_7d AS email_degree_7d;
      PRINT @@email_cards_window.size() AS email_distinct_cards_in_window;
    ELSE
      PRINT "purchaser email lifetime volume exceeds max_scan_rows; email features withheld, not partial"
        AS email_features_withheld_reason;
    END;
    PRINT @@email_rows_scanned AS email_rows_scanned;

    // Burst count: consecutive transactions on this card separated by less than
    // burst_gap_seconds, read from the gap_seconds precomputed on the NEXT
    // chain. This is the shape card testing makes -- several authorizations in
    // quick succession -- and it is a different signal from a high count over an
    // hour, which a steady shopper also produces.
    bursts = SELECT t2 FROM card:c -(MADE>)- Transaction:t1 -(NEXT>:e)- Transaction:t2
      WHERE t1.ts <= effective_cutoff AND t2.ts <= effective_cutoff
        AND e.gap_seconds <= burst_gap_seconds
      ACCUM @@burst_count += 1;

    PRINT @@burst_count AS burst_transitions;
    PRINT burst_gap_seconds AS burst_gap_seconds;
  END;
}
