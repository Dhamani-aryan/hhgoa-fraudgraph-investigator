// find_region_anomalies_v1
//
// Is the flagged transaction's billing region new for this card, and is the
// card also active elsewhere at the same time?
//
// The distinction the policy cares about: several days in one new region is a
// trip, while a new region alongside continuing activity elsewhere is a clone.
// Both sides come back so the caller can tell them apart instead of treating
// every new region as fraud.
//
// ---------------------------------------------------------------------------
// ADMISSIBILITY, CHECKED BEFORE ANYTHING IS RETURNED
// ---------------------------------------------------------------------------
// Two requests are refused outright, and refused means no transaction data of
// any kind comes back -- not the timestamp, not the region, not the history,
// not the concurrent activity:
//
//   * The flagged transaction postdates as_of_ts. It had not happened, so
//     returning even its region or timestamp would leak the future.
//   * The flagged transaction does not belong to the supplied card. That is a
//     caller bug, and answering it would attribute one card's region history to
//     another card's transaction.
//
// ---------------------------------------------------------------------------
// History is bounded by the FLAGGED TRANSACTION'S OWN TIMESTAMP, not by
// as_of_ts. Those differ whenever a case is reviewed later than it was
// triggered, and bounding by as_of_ts let a later cutoff grow the history from
// 52 entries to 58 while the flagged transaction never moved -- which would
// make a region look familiar on the strength of visits made after the alert
// fired. The cutoff still applies on top, so neither bound can be exceeded.

CREATE QUERY find_region_anomalies_v1(
  STRING card_id,
  STRING flagged_txn_id,
  STRING as_of_ts,
  INT home_window_hours = 72,
  INT max_rows = 200
) FOR GRAPH HHGOAFraud {
  DATETIME cutoff = to_datetime(as_of_ts);

  MapAccum<STRING, SumAccum<INT>> @@region_history;
  SumAccum<INT> @@flagged_region_prior_count;
  SumAccum<INT> @@other_region_activity;
  MinAccum<DATETIME> @@flagged_region_first_seen;
  MaxAccum<DATETIME> @@flagged_region_last_seen;

  STRING flagged_region = "";
  STRING flagged_card = "";
  DATETIME flagged_ts;
  BOOL found = FALSE;
  BOOL after_cutoff = FALSE;
  BOOL card_mismatch = FALSE;

  SEED = {Transaction.*};
  flagged = SELECT t FROM SEED:t WHERE t.txn_id == flagged_txn_id
    POST-ACCUM
      found = TRUE,
      flagged_ts = t.ts,
      flagged_region = t.addr1,
      flagged_card = t.card_id;

  IF NOT found THEN
    card_mismatch = TRUE;
  END;
  IF found AND flagged_card != card_id THEN
    card_mismatch = TRUE;
  END;
  IF found AND datetime_to_epoch(flagged_ts) > datetime_to_epoch(cutoff) THEN
    after_cutoff = TRUE;
  END;

  BOOL refused = (after_cutoff OR card_mismatch);

  PRINT refused AS refused;
  PRINT after_cutoff AS refused_flagged_after_cutoff;
  PRINT card_mismatch AS refused_card_mismatch;
  PRINT as_of_ts AS as_of_ts;

  IF refused THEN
    IF after_cutoff THEN
      PRINT "the flagged transaction postdates as_of_ts, so none of its detail is visible yet" AS refusal_reason;
    ELSE
      PRINT "the flagged transaction does not belong to the supplied card" AS refusal_reason;
    END;
  ELSE
    PRINT flagged_region AS flagged_region, flagged_ts AS flagged_ts;

    CARDS = {PaymentCard.*};
    card = SELECT c FROM CARDS:c WHERE c.card_id == card_id;

    history = SELECT t FROM card:c -(MADE>)- Transaction:t
      WHERE t.ts < flagged_ts AND t.ts <= cutoff
        AND t.txn_id != flagged_txn_id AND t.addr1 != ""
      ACCUM
        @@region_history += (t.addr1 -> 1),
        CASE WHEN t.addr1 == flagged_region THEN
          @@flagged_region_prior_count += 1,
          @@flagged_region_first_seen += t.ts,
          @@flagged_region_last_seen += t.ts
        END;

    PRINT @@region_history AS region_history;
    PRINT @@flagged_region_prior_count AS flagged_region_prior_count;
    PRINT (@@flagged_region_prior_count == 0) AS region_is_new_for_card;
    PRINT @@flagged_region_first_seen AS flagged_region_first_seen;
    PRINT @@flagged_region_last_seen AS flagged_region_last_seen;

    // Activity in a DIFFERENT region close in time to the flagged transaction.
    // Presence in two regions at once separates a clone from a trip.
    concurrent = SELECT t FROM card:c -(MADE>)- Transaction:t
      WHERE t.ts <= flagged_ts AND t.ts <= cutoff
        AND t.txn_id != flagged_txn_id
        AND t.addr1 != "" AND t.addr1 != flagged_region
        AND abs(datetime_to_epoch(t.ts) - datetime_to_epoch(flagged_ts)) <= home_window_hours * 3600
      ACCUM @@other_region_activity += 1
      ORDER BY t.ts DESC
      LIMIT max_rows;

    PRINT @@other_region_activity AS other_region_activity_in_window;
    PRINT concurrent[
      concurrent.txn_id, concurrent.ts, concurrent.addr1, concurrent.amount,
      concurrent.channel
    ] AS concurrent_other_region_activity;
  END;
}
