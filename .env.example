# ---------------------------------------------------------------------------
# TigerGraph connection
# ---------------------------------------------------------------------------
# Copy this file to .env and fill it in locally. .env is git-ignored and must
# never be committed. Leave this template's values empty.
#
# Two deployment paths are supported. TG_TGCLOUD picks which one, and which
# credential is required:
#
#   TG_TGCLOUD=true   Savanna / TigerGraph Cloud. Authenticates with a database
#                     SECRET, not a username and password. pyTigerGraph takes
#                     the secret as gsqlSecret and exchanges it for a token.
#                     Set TG_SECRET. TG_USERNAME and TG_PASSWORD are ignored.
#
#   TG_TGCLOUD=false  Community Edition or a self-managed server.
#                     Set TG_USERNAME and TG_PASSWORD.
#
# Where to get these in Savanna:
#   TG_HOST    the workspace's endpoint. Open the workspace, click Connect,
#              then Connect from API. Use the origin only, with no trailing
#              slash and no path, for example https://<workspace>.tgcloud.io
#   TG_SECRET  the workspace's Admin Portal, under User Management, create a
#              secret and give it an alias. Copy the value immediately: once
#              the page is refreshed the secret is masked and cannot be read
#              again. Create a new one if you lose it.
#
# Also enable auto-stop and auto-start on the workspace. The official brief
# requires it, and Gate 1 records it.

TG_HOST=
TG_GRAPHNAME=HHGOAFraud
TG_TGCLOUD=true

# Savanna / Cloud credential (required when TG_TGCLOUD=true)
TG_SECRET=

# Self-managed credentials (required when TG_TGCLOUD=false)
TG_USERNAME=
TG_PASSWORD=

# Optional: a pre-minted REST++ token. Normally left empty, because the client
# mints a short-lived token from TG_SECRET (or the username/password pair).
TG_API_TOKEN=

# TigerGraph MCP restricted tool surface (comma separated categories).
# 'vector' is required: TigerGraph vector search is the retrieval path for
# closed-case and policy memory, and the challenge requires it rather than a
# local fallback. Keep this list as narrow as the workflow allows.
TG_MCP_ALLOWED_TOOLS=schema,query,discovery,vector,utility

# ---------------------------------------------------------------------------
# LLM provider (not needed before Gate 4)
# ---------------------------------------------------------------------------
LLM_PROVIDER=
LLM_MODEL=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ---------------------------------------------------------------------------
# Local paths
# ---------------------------------------------------------------------------
DATA_DIR=./data/raw
RUNS_DIR=./runs
CASES_DIR=./cases

# ---------------------------------------------------------------------------
# Benchmark memory isolation and per-case budgets
# ---------------------------------------------------------------------------
MEMORY_EPOCH=hhgoa_2026_benchmark_v1
MAX_GRAPH_CALLS_PER_CASE=12
MAX_LLM_CALLS_PER_CASE=3
